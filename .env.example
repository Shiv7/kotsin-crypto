# Copy to backend/.env. Every key here is a field in backend/kotsin_crypto/config.py —
# an unknown KC_* key makes the process refuse to boot (docs/LEARNINGS.md R1).
# Trading MODE is deliberately not an env var (R9); it lives in the control table.

KC_ENV=dev                      # dev | prod  (prod → JSON logs)
KC_LOG_LEVEL=INFO

KC_DELTA_ENV=testnet            # testnet | mainnet   (endpoints resolved in config.py)
KC_DELTA_API_KEY=               # create separate keys: testnet / mainnet read-only / mainnet trade
KC_DELTA_API_SECRET=            # enable IP whitelisting on the Delta side

KC_SYMBOLS=BTCUSD,ETHUSD,SOLUSD # the only three with real depth on Delta India today

KC_DATA_DIR=./data              # Parquet archive + SQLite live here (git-ignored)
KC_DB_URL=sqlite+aiosqlite:///./data/kotsin_crypto.db

KC_TELEGRAM_BOT_TOKEN=          # optional; alerts are a no-op when unset
KC_TELEGRAM_CHAT_ID=

KC_API_HOST=127.0.0.1
KC_API_PORT=8400
